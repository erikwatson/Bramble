{
  "name": "@erikwatson/bramble",
  "version": "0.15.0",
  "description": "A creative coding library.",
  "main": "./dist/bramble.cjs",
  "module": "./dist/bramble.esm.js",
  "type": "module",
  "exports": {
    "import": "./dist/bramble.esm.js",
    "require": "./dist/bramble.cjs"
  },
  "types": "./dist/bramble.d.ts",
  "author": "Erik Watson <erik@erikwatson.me>",
  "license": "MIT",
  "files": [
    "dist/**/*"
  ],
  "devDependencies": {
    "copy-webpack-plugin": "^10",
    "http-server": "^0.12.3",
    "husky": "^1.3.1",
    "jest": "^24.0.0",
    "prettier": "^1.16.2",
    "pretty-quick": "^1.10.0",
    "ts-loader": "^9",
    "typedoc": "^0.23.16",
    "typescript": "^4.8.4",
    "typescript-coverage-report": "^0.3.1",
    "typescript-loader": "^1.1.3",
    "webpack": "^5",
    "webpack-bundle-analyzer": "^4.4.2",
    "webpack-cli": "^4",
    "webpack-dev-server": "^4",
    "webpack-merge": "^6"
  },
  "scripts": {
    "release": "npm run build && npm publish --access=public",
    "build": "webpack-cli --config webpack.prod.js && tsc --emitDeclarationOnly",
    "build:umd": "webpack-cli --config webpack.umdder.js",
    "watch": "webpack-cli --config webpack.dev.js --watch",
    "docs": "npx typedoc ./src/bramble.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erikwatson/Bramble.git"
  },
  "keywords": [
    "creative-coding",
    "game-development",
    "2d",
    "graphics",
    "canvas",
    "typescript",
    "javascript",
    "html5",
    "browser",
    "interactive"
  ],
  "bugs": {
    "url": "https://github.com/erikwatson/Bramble/issues"
  },
  "homepage": "https://github.com/erikwatson/Bramble",
  "packageManager": "pnpm@10.11.1+sha512.e519b9f7639869dc8d5c3c5dfef73b3f091094b0a006d7317353c72b124e80e1afd429732e28705ad6bfa1ee879c1fce46c128ccebd3192101f43dd67c667912"
}
